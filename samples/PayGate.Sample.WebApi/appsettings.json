{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Sample": "Data Source=paygate-sample.db"
  },
  "Payments": {
    "Account": "fake",
    "PublicBaseUrl": "http://localhost:5080/",
    "WebhookPrefix": "/webhooks",
    "ConfirmWithProvider": true,
    "AllowedReturnUrls": [],
    "Reconciliation": {
      "Enabled": true,
      "Interval": "00:05:00",
      "PendingOlderThan": "00:15:00",
      "StopAfter": "2.00:00:00",
      "BatchSize": 50
    },
    "Fake": {
      "Flow": "Redirect"
    },
    "Kashier": {
      "Environment": "Sandbox"
    }
  }
}
